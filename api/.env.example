# Copy to .env for local development. In production, load these from the
# managed secret store (spec section 19); the API refuses to start without them.
NODE_ENV=development
PORT=3000
# Load balancer addresses or CIDRs allowed to set X-Forwarded-For (comma separated).
# Leave empty when clients connect directly.
TRUST_PROXY=
DATABASE_URL=postgres://examguard:examguard@localhost:5432/examguard

# Required in production.
JWT_SECRET=
# Ed25519 private key (PKCS#8 PEM) used to sign exam manifests, and its id.
# Generate: openssl genpkey -algorithm ed25519
EXAM_SIGNING_PRIVATE_KEY=
EXAM_SIGNING_KEY_ID=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
INVITATION_TTL_HOURS=168
AUTH_RATE_LIMIT_PER_MINUTE=20
PUBLIC_BASE_URL=http://localhost:5173
PACKAGE_PREFETCH_MINUTES=10
ATTEMPT_GRACE_SECONDS=30

# Outgoing email, for example smtps://user:password@smtp.example.com:465.
# Without it, development prints each email to the log and production sends none.
SMTP_URL=
MAIL_FROM=ExamGuard <no-reply@example.com>

# Folder for recordings (camera, microphone and screen). Several API servers
# need shared storage: see docs/IMPLEMENTATION.md.
RECORDING_DIR=recordings

# S3 compatible storage for recordings (Amazon S3, MinIO, R2 and others).
# When S3_BUCKET is set, recordings go there instead of RECORDING_DIR.
S3_BUCKET=
S3_REGION=af-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to 0 for virtual host style addresses (bucket.s3.amazonaws.com).
S3_PATH_STYLE=
# For example AES256, to have the service encrypt each recording.
S3_SERVER_SIDE_ENCRYPTION=

# Address of the staff portal, for staff invitation and password reset links.
PORTAL_BASE_URL=http://localhost:5174

# STUN and TURN servers for live video and voice, as a JSON list of RTCIceServer
# objects. Without it a public STUN server is used. Strict networks need TURN, e.g.
# [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=

# Development only: set to 0 to stop webhooks and single sign on reaching local addresses.
ALLOW_PRIVATE_WEBHOOKS=

# Where identity providers send people back after single sign on. Register this
# address with each provider. Defaults to PUBLIC_BASE_URL/api/auth/sso/callback.
SSO_CALLBACK_URL=

# Redis, so sign in rate limits hold across several API servers, for example
# redis://redis.internal:6379. Optional with a single server.
REDIS_URL=

# Bearer token the monitoring system presents to GET /metrics. Without it,
# metrics are served in development only.
METRICS_TOKEN=

# Used once by `npm run seed` to create the first platform super admin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
